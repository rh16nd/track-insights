# Where the Flask prediction API lives (api.py in the athletics-predictor repo).
#
# Optional. Left unset, the app talks to http://localhost:5000, which is the
# right default for the local development setup: `python api.py` in the
# athletics-predictor folder, `npm run dev` here.
#
# Set it when the API is anywhere else -- a deployed instance, a LAN address,
# a tunnel. Until this existed the host was hardcoded at eight call sites, so
# a build served to anyone else fetched from THEIR machine and failed on every
# page. No trailing slash needed; one is stripped if present.
#
# VITE_ prefixed vars are injected at BUILD time, not read at runtime, so a
# change here needs a rebuild.
VITE_API_BASE_URL=http://localhost:5000
